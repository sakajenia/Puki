# Copy this file to ".env" and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → Data API / API Keys).
#
# These are EXPO_PUBLIC_* so they are bundled into the app at build time.
# The anon key is safe to ship in a client app — your data is protected by
# Row Level Security (see supabase/migrations/0001_init.sql), not by hiding this key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
